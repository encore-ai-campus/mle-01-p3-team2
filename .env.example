# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# --- Neo4j (필수) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# scripts/indexing/build_vector_index.py 는 NEO4J_USER 이름을 요구합니다.
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- OpenAI (필수) ---
OPENAI_API_KEY=
# 답변 생성용 채팅 모델
OPENAI_CHAT_MODEL=gpt-4.1-mini
# RAGAS 평가용 모델
OPENAI_EVAL_MODEL=gpt-4.1
# 출력 검증 LLM-as-Judge 모델
GUARDRAIL_JUDGE_MODEL=gpt-4o-mini

# --- Langfuse (trajectory 수집 시에만 필요) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
