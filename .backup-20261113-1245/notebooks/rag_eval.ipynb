    "# 후보 파일 로드 및 공통 스키마 정규화\n",
    "if not CANDIDATE_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"검수할 후보 파일이 없습니다: {CANDIDATE_PATH}\"\n",
    "    )\n",
    "\n",
    "candidates = []\n",
    "seen_case_ids = set()\n",
    "\n",
    "for row_number, raw_row in enumerate(\n",
    "    read_jsonl(CANDIDATE_PATH),\n",
    "    start=1,\n",
    "):\n",
    "    row = normalize_candidate(\n",
    "        raw_row,\n",
    "        row_number=row_number,\n",
    "        owner=REVIEWER_NAME,\n",
    "    )\n",
    "    if row[\"case_id\"] in seen_case_ids:\n",
    "        raise ValueError(f\"중복 case_id: {row['case_id']}\")\n",
    "    seen_case_ids.add(row[\"case_id\"])\n",
    "    candidates.append(row)\n",
    "\n",
    "# 기존 검수 결과를 case_id 기준으로 병합\n",
    "if REVIEWED_PATH.exists():\n",
    "    reviewed_by_id = {\n",
    "        row[\"case_id\"]: row\n",
    "        for row in read_jsonl(REVIEWED_PATH)\n",
    "    }\n",
    "    candidates = [\n",
    "        reviewed_by_id.get(row[\"case_id\"], row)\n",
    "        for row in candidates\n",
    "    ]\n",
    "\n",
    "# 과거 검수 파일에는 reference가 없을 수 있으므로 다시 생성\n",
    "for row in candidates:\n",
    "    row[\"reference\"] = make_reference(row)\n",
    "\n",
    "print(\"불러온 파일:\", CANDIDATE_PATH.name)\n",
    "print(\"전체 검수 문항:\", len(candidates))\n",
    "print(\n",
    "    \"상태별 개수:\",\n",
    "    dict(Counter(row.get(\"status\") for row in candidates)),\n",
    ")\n",
    "\n",
    "warning_rows = [\n",
    "    row\n",
    "    for row in candidates\n",
    "    if row.get(\"normalization_warnings\")\n",
    "]\n",
    "if warning_rows:\n",
    "    print(\"\\n정규화 확인 필요\")\n",
    "    for row in warning_rows:\n",
    "        print(\n",
    "            \"-\",\n",
    "            row[\"case_id\"],\n",
    "            row[\"normalization_warnings\"],\n",
    "        )\n"
   ]
