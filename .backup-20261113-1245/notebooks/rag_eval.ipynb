    "import copy\n",
    "import json\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "\n",
    "# notebooks 폴더와 프로젝트 루트 어디에서 실행해도 경로가 맞도록 설정\n",
    "ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "PROCESSED = ROOT / \"data\" / \"processed\"\n",
    "EVALUATION = ROOT / \"data\" / \"evaluation\"\n",
    "TEAM_DIR = EVALUATION / \"team_candidates\"\n",
    "\n",
    "# 본인 이름으로 변경: candidates_{이름}.jsonl -> reviewed_{이름}.jsonl\n",
    "REVIEWER_NAME = \"유건\"\n",
    "CANDIDATE_PATH = TEAM_DIR / f\"candidates_{REVIEWER_NAME}.jsonl\"\n",
    "REVIEWED_PATH = TEAM_DIR / f\"reviewed_{REVIEWER_NAME}.jsonl\"\n",
    "\n",
    "TEAM_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"프로젝트 루트:\", ROOT)\n",
    "print(\"입력 파일:\", CANDIDATE_PATH)\n",
    "print(\"검수 결과:\", REVIEWED_PATH)\n"
   ]
