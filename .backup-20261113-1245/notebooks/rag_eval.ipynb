    "def read_jsonl(path):\n",
    "    with path.open(\"r\", encoding=\"utf-8\") as file:\n",
    "        return [json.loads(line) for line in file if line.strip()]\n",
    "\n",
    "\n",
    "def write_jsonl(path, rows, overwrite=False):\n",
    "    if path.exists() and not overwrite:\n",
    "        raise FileExistsError(\n",
    "            f\"{path}이 이미 있습니다. 기존 파일을 확인하거나 \"\n",
    "            \"OVERWRITE_FINAL=True로 바꾸세요.\"\n",
    "        )\n",
    "\n",
    "    temporary_path = path.with_suffix(path.suffix + \".tmp\")\n",
    "    with temporary_path.open(\"w\", encoding=\"utf-8\") as file:\n",
    "        for row in rows:\n",
    "            file.write(json.dumps(row, ensure_ascii=False) + \"\\n\")\n",
    "    temporary_path.replace(path)\n",
    "\n",
    "\n",
    "def ensure_list(value):\n",
    "    if value is None:\n",
    "        return []\n",
    "    return value if isinstance(value, list) else [value]\n",
    "\n",
    "\n",
    "def add_terminal_punctuation(text):\n",
    "    text = str(text).strip()\n",
    "    if text and text[-1] not in \".!?。！？\":\n",
    "        text += \".\"\n",
    "    return text\n",
    "\n",
    "\n",
    "def make_reference(row):\n",
    "    sentences = [\n",
    "        add_terminal_punctuation(fact)\n",
    "        for fact in ensure_list(row.get(\"expected_facts\"))\n",
    "        if str(fact).strip()\n",
    "    ]\n",
    "\n",
    "    if row.get(\"expected_behavior\") == \"ANSWER_WITH_WARNING\":\n",
    "        sentences.extend(\n",
    "            add_terminal_punctuation(assertion)\n",
    "            for assertion in ensure_list(row.get(\"safety_assertions\"))\n",
    "            if str(assertion).strip()\n",
    "        )\n",
    "\n",
    "    # 순서를 유지하면서 완전히 같은 문장만 제거\n",
    "    return \" \".join(dict.fromkeys(sentences))\n",
    "\n",
    "\n",
    "FIELD_ALIASES = {\n",
    "    \"case_id\": [\"case_id\", \"question_id\", \"id\"],\n",
    "    \"question\": [\"question\", \"input\", \"user_input\", \"query\"],\n",
    "    \"query_strategy\": [\"query_strategy\", \"strategy\", \"route\", \"search_type\"],\n",
    "    \"expected_behavior\": [\"expected_behavior\", \"behavior\"],\n",
    "    \"expected_facts\": [\n",
    "        \"expected_facts\",\n",
    "        \"ground_truth_facts\",\n",
    "        \"reference_facts\",\n",
    "    ],\n",
    "    \"expected_entity_ids\": [\"expected_entity_ids\", \"entity_ids\"],\n",
    "    \"expected_relation_ids\": [\"expected_relation_ids\", \"relation_ids\"],\n",
    "    \"expected_evidence_ids\": [\"expected_evidence_ids\", \"evidence_ids\"],\n",
    "    \"expected_source_chunk_ids\": [\n",
    "        \"expected_source_chunk_ids\",\n",
    "        \"source_chunk_ids\",\n",
    "        \"reference_context_ids\",\n",
    "        \"context_ids\",\n",
    "    ],\n",
    "    \"safety_assertions\": [\n",
    "        \"safety_assertions\",\n",
    "        \"safety_rules\",\n",
    "        \"warnings\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "\n",
    "def find_value(row, canonical_key, default=None):\n",
    "    for key in FIELD_ALIASES[canonical_key]:\n",
    "        if key in row:\n",
    "            return row[key]\n",
    "    return default\n",
    "\n",
    "\n",
    "def normalize_candidate(raw_row, row_number, owner=None):\n",
    "    row = copy.deepcopy(raw_row)\n",
    "    warnings = []\n",
    "\n",
    "    original_case_id = str(\n",
    "        find_value(row, \"case_id\", f\"ROW_{row_number:04d}\")\n",
    "    )\n",
    "    question = find_value(row, \"question\")\n",
    "    if not question:\n",
    "        raise KeyError(\n",
    "            f\"{owner or 'personal'} {original_case_id}: \"\n",
    "            \"질문 키를 찾을 수 없습니다.\"\n",
    "        )\n",
    "\n",
    "    expected_facts = find_value(row, \"expected_facts\")\n",
    "    if expected_facts is None:\n",
    "        supplied_reference = (\n",
    "            row.get(\"reference\") or row.get(\"expected_output\")\n",
    "        )\n",
    "        if supplied_reference:\n",
    "            expected_facts = [supplied_reference]\n",
    "            warnings.append(\n",
    "                \"reference 전체를 기대 사실 1개로 변환함: \"\n",
    "                \"원자적 사실로 분리 필요\"\n",
    "            )\n",
    "        else:\n",
    "            expected_facts = []\n",
    "            warnings.append(\"기대 사실이 없음\")\n",
    "\n",
    "    case_id = (\n",
    "        f\"{owner}__{original_case_id}\"\n",
    "        if owner\n",
    "        else original_case_id\n",
    "    )\n",
    "    normalized = {\n",
    "        \"case_id\": case_id,\n",
    "        \"question\": str(question).strip(),\n",
    "        \"question_type\": row.get(\n",
    "            \"question_type\",\n",
    "            \"unclassified\",\n",
    "        ),\n",
    "        \"difficulty\": row.get(\n",
    "            \"difficulty\",\n",
    "            \"unclassified\",\n",
    "        ),\n",
    "        \"query_strategy\": find_value(\n",
    "            row,\n",
    "            \"query_strategy\",\n",
    "            \"unclassified\",\n",
    "        ),\n",
    "        \"expected_behavior\": find_value(\n",
    "            row,\n",
    "            \"expected_behavior\",\n",
    "            \"ANSWER\",\n",
    "        ),\n",
    "        \"expected_facts\": ensure_list(expected_facts),\n",
    "        \"expected_entity_ids\": ensure_list(\n",
    "            find_value(row, \"expected_entity_ids\", [])\n",
    "        ),\n",
    "        \"expected_relation_ids\": ensure_list(\n",
    "            find_value(row, \"expected_relation_ids\", [])\n",
    "        ),\n",
    "        \"expected_evidence_ids\": ensure_list(\n",
    "            find_value(row, \"expected_evidence_ids\", [])\n",
    "        ),\n",
    "        \"expected_source_chunk_ids\": ensure_list(\n",
    "            find_value(row, \"expected_source_chunk_ids\", [])\n",
    "        ),\n",
    "        \"safety_assertions\": ensure_list(\n",
    "            find_value(row, \"safety_assertions\", [])\n",
    "        ),\n",
    "        \"status\": row.get(\"status\", \"PENDING_REVIEW\"),\n",
    "        \"review\": row.get(\n",
    "            \"review\",\n",
    "            {\n",
    "                \"question_ok\": None,\n",
    "                \"facts_ok\": None,\n",
    "                \"evidence_ok\": None,\n",
    "                \"ids_ok\": None,\n",
    "                \"reviewer_note\": \"\",\n",
    "            },\n",
    "        ),\n",
    "        \"normalization_warnings\": warnings,\n",
    "    }\n",
    "\n",
    "    if owner:\n",
    "        normalized[\"candidate_owner\"] = owner\n",
    "        normalized[\"original_case_id\"] = original_case_id\n",
    "    if \"generation_metadata\" in row:\n",
    "        normalized[\"generation_metadata\"] = row[\"generation_metadata\"]\n",
    "\n",
    "    normalized[\"reference\"] = make_reference(normalized)\n",
    "    return normalized\n"
   ]
  },
