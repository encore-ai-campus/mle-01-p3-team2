    "import ipywidgets as widgets\n",
    "from IPython.display import clear_output, display\n",
    "\n",
    "if not candidates:\n",
    "    raise ValueError(\"검수할 문항이 없습니다.\")\n",
    "\n",
    "first_pending = next(\n",
    "    (\n",
    "        index\n",
    "        for index, row in enumerate(candidates)\n",
    "        if row.get(\"status\") == \"PENDING_REVIEW\"\n",
    "    ),\n",
    "    0,\n",
    ")\n",
    "state = {\"index\": first_pending}\n",
    "\n",
    "title = widgets.HTML()\n",
    "question_box = widgets.Textarea(\n",
    "    disabled=True,\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"90px\"),\n",
    ")\n",
    "facts_box = widgets.Textarea(\n",
    "    disabled=True,\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"140px\"),\n",
    ")\n",
    "reference_box = widgets.Textarea(\n",
    "    disabled=True,\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"140px\"),\n",
    ")\n",
    "graph_box = widgets.Textarea(\n",
    "    disabled=True,\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"130px\"),\n",
    ")\n",
    "evidence_box = widgets.Textarea(\n",
    "    disabled=True,\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"300px\"),\n",
    ")\n",
    "id_result = widgets.HTML()\n",
    "\n",
    "toggle_options = [\n",
    "    (\"미검수\", None),\n",
    "    (\"통과\", True),\n",
    "    (\"수정·제외\", False),\n",
    "]\n",
    "question_ok = widgets.ToggleButtons(\n",
    "    options=toggle_options,\n",
    "    description=\"질문\",\n",
    ")\n",
    "facts_ok = widgets.ToggleButtons(\n",
    "    options=toggle_options,\n",
    "    description=\"기대 사실\",\n",
    ")\n",
    "evidence_ok = widgets.ToggleButtons(\n",
    "    options=toggle_options,\n",
    "    description=\"근거\",\n",
    ")\n",
    "reviewer_note = widgets.Textarea(\n",
    "    placeholder=\"수정 사항이나 제외 이유\",\n",
    "    layout=widgets.Layout(width=\"100%\", height=\"80px\"),\n",
    ")\n",
    "\n",
    "previous_button = widgets.Button(description=\"이전\")\n",
    "approve_button = widgets.Button(\n",
    "    description=\"모두 통과\",\n",
    "    button_style=\"success\",\n",
    ")\n",
    "save_button = widgets.Button(\n",
    "    description=\"현재 판정 저장\",\n",
    "    button_style=\"info\",\n",
    ")\n",
    "reject_button = widgets.Button(\n",
    "    description=\"제외\",\n",
    "    button_style=\"danger\",\n",
    ")\n",
    "next_button = widgets.Button(description=\"다음\")\n",
    "status_output = widgets.Output()\n",
    "\n",
    "\n",
    "def save_all():\n",
    "    temporary_path = REVIEWED_PATH.with_suffix(\n",
    "        REVIEWED_PATH.suffix + \".tmp\"\n",
    "    )\n",
    "    with temporary_path.open(\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        for row in candidates:\n",
    "            row[\"reference\"] = make_reference(row)\n",
    "            file.write(\n",
    "                json.dumps(\n",
    "                    row,\n",
    "                    ensure_ascii=False,\n",
    "                )\n",
    "                + \"\\n\"\n",
    "            )\n",
    "    temporary_path.replace(REVIEWED_PATH)\n",
    "\n",
    "\n",
    "def render():\n",
    "    row = candidates[state[\"index\"]]\n",
    "    review = row.get(\"review\", {})\n",
    "    owner_text = (\n",
    "        f\" · 작성자 {row['candidate_owner']}\"\n",
    "        if row.get(\"candidate_owner\")\n",
    "        else \"\"\n",
    "    )\n",
    "    title.value = (\n",
    "        f\"<h3>{state['index'] + 1}/{len(candidates)}\"\n",
    "        f\"{owner_text} · {row['case_id']} \"\n",
    "        f\"· {row['query_strategy']} \"\n",
    "        f\"· {row.get('status')}</h3>\"\n",
    "    )\n",
    "    question_box.value = row[\"question\"]\n",
    "    facts_box.value = \"\\n\".join(\n",
    "        f\"- {fact}\"\n",
    "        for fact in row.get(\"expected_facts\", [])\n",
    "    )\n",
    "    row[\"reference\"] = make_reference(row)\n",
    "    reference_box.value = row[\"reference\"]\n",
    "\n",
    "    evidence_texts = []\n",
    "    for evidence_id in row.get(\n",
    "        \"expected_evidence_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        evidence = evidence_by_id.get(evidence_id)\n",
    "        if evidence is None:\n",
    "            evidence_texts.append(\n",
    "                f\"[{evidence_id}]\\n\"\n",
    "                \"근거를 찾을 수 없습니다.\"\n",
    "            )\n",
    "        else:\n",
    "            evidence_texts.append(\n",
    "                f\"[{evidence_id} / \"\n",
    "                f\"{evidence.get('evidence_type', 'unknown')}]\\n\"\n",
    "                f\"{evidence.get('text', '')}\"\n",
    "            )\n",
    "    evidence_box.value = (\n",
    "        \"\\n\\n\".join(evidence_texts)\n",
    "        or \"근거 원문 없음\"\n",
    "    )\n",
    "\n",
    "    graph_lines = []\n",
    "    for relation_id in row.get(\n",
    "        \"expected_relation_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        relation = relation_by_id.get(relation_id)\n",
    "        if relation is None:\n",
    "            graph_lines.append(\n",
    "                f\"{relation_id}: 관계 없음\"\n",
    "            )\n",
    "            continue\n",
    "        from_entity = entity_by_id.get(\n",
    "            relation[\"from_id\"],\n",
    "            {},\n",
    "        ).get(\"name\", relation[\"from_id\"])\n",
    "        to_entity = entity_by_id.get(\n",
    "            relation[\"to_id\"],\n",
    "            {},\n",
    "        ).get(\"name\", relation[\"to_id\"])\n",
    "        graph_lines.append(\n",
    "            f\"{from_entity} \"\n",
    "            f\"--{relation['relation_type']}--> \"\n",
    "            f\"{to_entity}\"\n",
    "        )\n",
    "    graph_box.value = (\n",
    "        \"\\n\".join(graph_lines)\n",
    "        if graph_lines\n",
    "        else \"그래프 관계 없음\"\n",
    "    )\n",
    "\n",
    "    errors = validate_ids(row)\n",
    "    id_result.value = (\n",
    "        \"<b style='color:red'>ID 자동 검사 실패</b><br>\"\n",
    "        + \"<br>\".join(errors)\n",
    "        if errors\n",
    "        else \"<b style='color:green'>ID 자동 검사 통과</b>\"\n",
    "    )\n",
    "    question_ok.value = review.get(\"question_ok\")\n",
    "    facts_ok.value = review.get(\"facts_ok\")\n",
    "    evidence_ok.value = review.get(\"evidence_ok\")\n",
    "    reviewer_note.value = review.get(\n",
    "        \"reviewer_note\",\n",
    "        \"\",\n",
    "    )\n",
    "\n",
    "\n",
    "def save_current(force_reject=False):\n",
    "    row = candidates[state[\"index\"]]\n",
    "    id_errors = validate_ids(row)\n",
    "\n",
    "    q_result = (\n",
    "        False\n",
    "        if force_reject\n",
    "        else question_ok.value\n",
    "    )\n",
    "    f_result = (\n",
    "        False\n",
    "        if force_reject\n",
    "        else facts_ok.value\n",
    "    )\n",
    "    e_result = (\n",
    "        False\n",
    "        if force_reject\n",
    "        else evidence_ok.value\n",
    "    )\n",
    "\n",
    "    row[\"review\"] = {\n",
    "        \"question_ok\": q_result,\n",
    "        \"facts_ok\": f_result,\n",
    "        \"evidence_ok\": e_result,\n",
    "        \"ids_ok\": not id_errors,\n",
    "        \"reviewer_note\": reviewer_note.value.strip(),\n",
    "    }\n",
    "    checks = [\n",
    "        q_result,\n",
    "        f_result,\n",
    "        e_result,\n",
    "        not id_errors,\n",
    "    ]\n",
    "\n",
    "    if all(value is True for value in checks):\n",
    "        row[\"status\"] = \"READY\"\n",
    "    elif any(value is False for value in checks):\n",
    "        row[\"status\"] = \"REJECTED\"\n",
    "    else:\n",
    "        row[\"status\"] = \"PENDING_REVIEW\"\n",
    "\n",
    "    row[\"reference\"] = make_reference(row)\n",
    "    save_all()\n",
    "\n",
    "    with status_output:\n",
    "        clear_output()\n",
    "        print(\n",
    "            row[\"case_id\"],\n",
    "            \"저장 완료\",\n",
    "            row[\"status\"],\n",
    "        )\n",
    "\n",
    "\n",
    "def move(step):\n",
    "    state[\"index\"] = min(\n",
    "        max(state[\"index\"] + step, 0),\n",
    "        len(candidates) - 1,\n",
    "    )\n",
    "    render()\n",
    "\n",
    "\n",
    "def approve_current(_):\n",
    "    question_ok.value = True\n",
    "    facts_ok.value = True\n",
    "    evidence_ok.value = True\n",
    "    save_current()\n",
    "    move(1)\n",
    "\n",
    "\n",
    "def reject_current(_):\n",
    "    save_current(force_reject=True)\n",
    "    move(1)\n",
    "\n",
    "\n",
    "previous_button.on_click(lambda _: move(-1))\n",
    "next_button.on_click(lambda _: move(1))\n",
    "approve_button.on_click(approve_current)\n",
    "save_button.on_click(lambda _: save_current())\n",
    "reject_button.on_click(reject_current)\n",
    "\n",
    "display(\n",
    "    title,\n",
    "    widgets.HTML(\"<b>질문</b>\"),\n",
    "    question_box,\n",
    "    widgets.HTML(\"<b>기대 사실</b>\"),\n",
    "    facts_box,\n",
    "    widgets.HTML(\"<b>자동 생성 reference</b>\"),\n",
    "    reference_box,\n",
    "    widgets.HTML(\"<b>그래프 관계</b>\"),\n",
    "    graph_box,\n",
    "    widgets.HTML(\"<b>근거 원문</b>\"),\n",
    "    evidence_box,\n",
    "    id_result,\n",
    "    question_ok,\n",
    "    facts_ok,\n",
    "    evidence_ok,\n",
    "    reviewer_note,\n",
    "    widgets.HBox(\n",
    "        [\n",
    "            previous_button,\n",
    "            approve_button,\n",
    "            save_button,\n",
    "            reject_button,\n",
    "            next_button,\n",
    "        ]\n",
    "    ),\n",
    "    status_output,\n",
    ")\n",
    "render()\n"
   ]
  }
 ],
