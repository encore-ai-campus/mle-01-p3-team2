    "def validate_ids(candidate):\n",
    "    errors = []\n",
    "\n",
    "    for evidence_id in candidate.get(\n",
    "        \"expected_evidence_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        if evidence_id not in evidence_by_id:\n",
    "            errors.append(\n",
    "                f\"존재하지 않는 evidence ID: {evidence_id}\"\n",
    "            )\n",
    "\n",
    "    for entity_id in candidate.get(\n",
    "        \"expected_entity_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        if entity_id not in entity_by_id:\n",
    "            errors.append(\n",
    "                f\"존재하지 않는 entity ID: {entity_id}\"\n",
    "            )\n",
    "\n",
    "    for relation_id in candidate.get(\n",
    "        \"expected_relation_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        if relation_id not in relation_by_id:\n",
    "            errors.append(\n",
    "                f\"존재하지 않는 relation ID: {relation_id}\"\n",
    "            )\n",
    "\n",
    "    expected_evidence = set(\n",
    "        candidate.get(\"expected_evidence_ids\", [])\n",
    "    )\n",
    "    for chunk_id in candidate.get(\n",
    "        \"expected_source_chunk_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        chunk = chunk_by_id.get(chunk_id)\n",
    "        if chunk is None:\n",
    "            errors.append(\n",
    "                f\"존재하지 않는 chunk ID: {chunk_id}\"\n",
    "            )\n",
    "            continue\n",
    "        if chunk.get(\"evidence_id\") not in expected_evidence:\n",
    "            errors.append(\n",
    "                f\"{chunk_id}가 기대 evidence와 연결되지 않음\"\n",
    "            )\n",
    "\n",
    "    for relation_id in candidate.get(\n",
    "        \"expected_relation_ids\",\n",
    "        [],\n",
    "    ):\n",
    "        relation = relation_by_id.get(relation_id)\n",
    "        if relation is None:\n",
    "            continue\n",
    "        relation_evidence = set(\n",
    "            relation.get(\"evidence_ids\", [])\n",
    "        )\n",
    "        if (\n",
    "            relation_evidence\n",
    "            and not relation_evidence & expected_evidence\n",
    "        ):\n",
    "            errors.append(\n",
    "                f\"{relation_id}의 근거가 \"\n",
    "                \"expected_evidence_ids에 없음\"\n",
    "            )\n",
    "\n",
    "    return errors\n",
    "\n",
    "\n",
    "invalid_rows = {\n",
    "    row[\"case_id\"]: validate_ids(row)\n",
    "    for row in candidates\n",
    "}\n",
    "invalid_rows = {\n",
    "    case_id: errors\n",
    "    for case_id, errors in invalid_rows.items()\n",
    "    if errors\n",
    "}\n",
    "print(\"ID 검사 실패 문항:\", len(invalid_rows))\n",
    "for case_id, errors in invalid_rows.items():\n",
    "    print(\"-\", case_id, errors)\n"
